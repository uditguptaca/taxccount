# Copy to .env.local for local development. On Vercel these are set in the
# project's settings: DATABASE_URL comes from the Storage tab when you create
# a Postgres database and connect it to the project; JWT_SECRET you add by hand.

# PostgreSQL connection string (any Postgres: Neon on Vercel, a local server, …)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taxccount

# Long random string used to sign login sessions. Required in production.
JWT_SECRET=
